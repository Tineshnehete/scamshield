{
  "manifest_version": 3,
  "name": "ScamShield Website Report",
  "version": "1.0",
  "description": "Check website reports using ScamShield APIs.",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": ["http://localhost:8000/*", "*://*/*"],
  
  "action": {
    "default_popup": "hello.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}